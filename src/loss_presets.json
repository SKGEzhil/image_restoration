{
  "l1": {
    "mode": "additive",
    "losses": {
      "l1": { "enabled": true, "weight": 1.0 }
    }
  },

  "charbonnier": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 }
    }
  },

  "l2": {
    "mode": "additive",
    "losses": {
      "l2": { "enabled": true, "weight": 1.0 }
    }
  },

  "ms_ssim": {
    "mode": "additive",
    "losses": {
      "ms_ssim": { "enabled": true, "weight": 1.0 }
    }
  },

  "log_l1": {
    "mode": "additive",
    "losses": {
      "log_l1": { "enabled": true, "weight": 1.0, "epsilon": 1e-6 }
    }
  },

  "gradient": {
    "mode": "additive",
    "losses": {
      "gradient": { "enabled": true, "weight": 1.0, "kernel": "sobel" }
    }
  },

  "ffl": {
    "mode": "additive",
    "losses": {
      "ffl": { "enabled": true, "weight": 1.0, "alpha": 1.0, "ramp_epochs": 15 }
    }
  },

  "tv": {
    "mode": "additive",
    "losses": {
      "tv": { "enabled": true, "weight": 1.0 }
    }
  },

  "l1_ssim_baseline": {
    "mode": "additive",
    "losses": {
      "l1": { "enabled": true, "weight": 1.0 },
      "ssim": { "enabled": true, "weight": 0.2 }
    }
  },

  "char_msssim": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 }
    }
  },

  "char_msssim_grad": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "gradient": { "enabled": true, "weight": 0.1, "kernel": "sobel" }
    }
  },

  "char_msssim_grad_ffl": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "gradient": { "enabled": true, "weight": 0.1, "kernel": "sobel" },
      "ffl": { "enabled": true, "weight": 0.1, "alpha": 1.0, "ramp_epochs": 15 }
    }
  },

  "char_msssim_logl1": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "log_l1": { "enabled": true, "weight": 0.3, "epsilon": 1e-6 }
    }
  },

  "char_msssim_logl1_ffl": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "log_l1": { "enabled": true, "weight": 0.3, "epsilon": 1e-6 },
      "ffl": { "enabled": true, "weight": 0.1, "alpha": 1.0, "ramp_epochs": 15 }
    }
  },

  "full_stack_tv": {
    "mode": "additive",
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "gradient": { "enabled": true, "weight": 0.1, "kernel": "sobel" },
      "ffl": { "enabled": true, "weight": 0.1, "alpha": 1.0, "ramp_epochs": 15 },
      "tv": { "enabled": true, "weight": 1e-4 }
    }
  },

  "geo_char_msssim": {
    "mode": "geometric",
    "geometric_terms": ["charbonnier", "ms_ssim"],
    "losses": {
      "charbonnier": { "enabled": true, "weight": 0.6, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.4 }
    }
  },

  "geo_char_msssim_plus_ffl": {
    "mode": "geometric",
    "geometric_terms": ["charbonnier", "ms_ssim"],
    "losses": {
      "charbonnier": { "enabled": true, "weight": 0.6, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.4 },
      "ffl": { "enabled": true, "weight": 0.1, "alpha": 1.0, "ramp_epochs": 15 }
    }
  },

  "geo_char_msssim_grad": {
    "mode": "geometric",
    "geometric_terms": ["charbonnier", "ms_ssim", "gradient"],
    "losses": {
      "charbonnier": { "enabled": true, "weight": 0.45, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.35 },
      "gradient": { "enabled": true, "weight": 0.20, "kernel": "sobel" }
    }
  },

  "uncert_char_msssim_grad": {
    "mode": "uncertainty",
    "uncertainty_terms": ["charbonnier", "ms_ssim", "gradient"],
    "uncertainty_init_sigma": 1.0,
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "gradient": { "enabled": true, "weight": 0.1, "kernel": "sobel" }
    }
  },

  "uncert_full_stack": {
    "mode": "uncertainty",
    "uncertainty_terms": ["charbonnier", "ms_ssim", "gradient", "ffl"],
    "uncertainty_init_sigma": 1.0,
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "gradient": { "enabled": true, "weight": 0.1, "kernel": "sobel" },
      "ffl": { "enabled": true, "weight": 0.1, "alpha": 1.0, "ramp_epochs": 15 }
    }
  },

  "uncert_char_msssim_logl1": {
    "mode": "uncertainty",
    "uncertainty_terms": ["charbonnier", "ms_ssim", "log_l1"],
    "uncertainty_init_sigma": 1.0,
    "losses": {
      "charbonnier": { "enabled": true, "weight": 1.0, "epsilon": 1e-3 },
      "ms_ssim": { "enabled": true, "weight": 0.2 },
      "log_l1": { "enabled": true, "weight": 0.3, "epsilon": 1e-6 }
    }
  }
}